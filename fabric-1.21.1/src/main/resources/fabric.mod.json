    ],
    "jade": [
      "com.velorise.staves.compat.jade.VeloriseStavesJadePlugin"
    ],
    "modmenu": [
      "com.velorise.staves.compat.modmenu.VeloriseModMenuIntegration"
    ],
    "jei_mod_plugin": [
