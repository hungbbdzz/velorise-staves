{
  "schemaVersion": 1,
  "id": "velorise_staves",
  "version": "${version}",
  "name": "Velorise's Staves",
  "description": "Vanilla-friendly magic staves and utility artifacts powered by durability and cooldowns.",
  "authors": [
    "hungbbdzz"
  ],
  "contact": {
    "homepage": "https://github.com/hungbbdzz/velorise-staves",
    "sources": "https://github.com/hungbbdzz/velorise-staves"
  },
  "license": "MIT",
  "icon": "assets/velorise_staves/textures/item/elemental_codex.png",
  "environment": "*",
  "entrypoints": {
